{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/app",
  "rewrites": [
    {
      "source": "/api/leaves/:id/status",
      "destination": "/api/leaves?action=status&id=:id"
    },
    {
      "source": "/api/roles/department/:id",
      "destination": "/api/roles?departmentId=:id"
    },
    {
      "source": "/api/managers/:id",
      "destination": "/api/managers?route=employee&id=:id"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/notifications?proxy=reviews&path="
    },
    {
      "source": "/api/reviews/:path*",
      "destination": "/api/notifications?proxy=reviews&path=:path*"
    },
    {
      "source": "/api/jira/:path*",
      "destination": "/api/projects?proxy=jira&path=:path*"
    },
    {
      "source": "/api/leaves/employee-leaves/all",
      "destination": "/api/leaves?view=employee-leaves"
    },
    {
      "source": "/api/leaves/employee/:id",
      "destination": "/api/leaves?view=employee&id=:id"
    },
    {
      "source": "/api/department-roles",
      "destination": "/api/departments?aggregate=roles"
    },
    {
      "source": "/api/salary-data",
      "destination": "/api/salaries?aggregate=data"
    },
    {
      "source": "/api/admins/login",
      "destination": "/api/admins?route=login"
    },
    {
      "source": "/api/admins/verify-email",
      "destination": "/api/admins?route=verify-email"
    },
    {
      "source": "/api/admins/reset-password",
      "destination": "/api/admins?route=reset-password"
    },
    {
      "source": "/api/admins/:id",
      "destination": "/api/admins?route=id&id=:id"
    },
    {
      "source": "/api/employees/login",
      "destination": "/api/employees?route=login"
    },
    {
      "source": "/api/employees/verify-email",
      "destination": "/api/employees?route=verify-email"
    },
    {
      "source": "/api/employees/reset-password",
      "destination": "/api/employees?route=reset-password"
    },
    {
      "source": "/api/employees/managers",
      "destination": "/api/managers"
    },
    {
      "source": "/api/employees/:id",
      "destination": "/api/employees?route=id&id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
